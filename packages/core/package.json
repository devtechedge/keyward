{
  "name": "@keyward/core",
  "version": "0.1.0",
  "description": "Provider adapters, fan-out rotation engine and anomaly detection for keyward.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "npm run build && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --experimental-strip-types \"test/**/*.test.ts\""
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
