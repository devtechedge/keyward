{
  "name": "keyward",
  "version": "0.1.0",
  "private": true,
  "description": "Find, rotate and police every AI API key your company holds.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "keyward": "packages/cli/dist/bin.js"
  },
  "files": [
    "packages/core",
    "packages/cli",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@keyward/core": "file:packages/core"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:core": "npm run build --workspace @keyward/core",
    "build:cli": "npm run build --workspace @keyward/cli",
    "build:web": "npm run build --workspace @keyward/core && npm run build --workspace @keyward/web",
    "dev:web": "npm run dev --workspace @keyward/web",
    "dev:cli": "npm run dev --workspace @keyward/cli",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "prepare": "tsc -p packages/core/tsconfig.build.json && tsc -p packages/cli/tsconfig.build.json"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^24.10.1"
  }
}
